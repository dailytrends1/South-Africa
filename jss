        .gc-widget, .gc-widget * { box-sizing: border-box; }

        /* ── Floating button with label ── */
        .gc-btn {
          position: fixed;
          bottom: 24px;
          right: 24px;
          z-index: 49;
          display: flex;
          align-items: center;
          gap: 8px;
          padding: 0 18px 0 14px;
          height: 48px;
          background: #050505;
          border: 1.5px solid #39ff14;
          box-shadow: 0 0 16px rgba(57,255,20,0.25), 0 4px 20px rgba(0,0,0,0.5);
          cursor: pointer;
          border-radius: 999px;
          transition: box-shadow .2s ease, transform .15s ease;
          outline: none;
          white-space: nowrap;
        }
        .gc-btn:hover {
          box-shadow: 0 0 28px rgba(57,255,20,0.45), 0 6px 24px rgba(0,0,0,0.6);
          transform: translateY(-2px);
        }
        .gc-btn:active { transform: translateY(0px); }

        .gc-btn-icon {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 26px;
          height: 26px;
          background: #39ff14;
          border-radius: 50%;
          flex-shrink: 0;
        }

        .gc-btn-label {
          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 11px;
          font-weight: 700;
          letter-spacing: .08em;
          text-transform: uppercase;
          color: #39ff14;
        }

        /* Unread badge */
        .gc-badge {
          position: absolute;
          top: -3px;
          right: -3px;
          width: 12px;
          height: 12px;
          background: #ff3f3f;
          border: 2px solid #050505;
          border-radius: 50%;
          animation: gc-badge-pulse 2s ease infinite;
        }
        @keyframes gc-badge-pulse {
          0%,100% { transform: scale(1); opacity:1; }
          50%      { transform: scale(1.3); opacity:.7; }
        }

        /* ── Chat panel ── */
        .gc-panel {
          position: fixed;
          bottom: 84px;
          right: 24px;
          z-index: 50;
          width: 360px;
          max-width: calc(100vw - 32px);
          height: 510px;
          max-height: calc(100dvh - 110px);
          background: #0a0a0a;
          border: 1px solid rgba(57,255,20,0.2);
          border-radius: 16px;
          box-shadow: 0 0 0 1px rgba(57,255,20,0.05), 0 24px 60px rgba(0,0,0,0.7), 0 0 40px rgba(57,255,20,0.06);
          display: flex;
          flex-direction: column;
          overflow: hidden;
          animation: gc-open .22s cubic-bezier(.34,1.56,.64,1) forwards;
          transform-origin: bottom right;
        }
        @keyframes gc-open {
          from { opacity:0; transform:scale(.88) translateY(10px); }
          to   { opacity:1; transform:scale(1)   translateY(0); }
        }

        /* ── Header ── */
        .gc-header {
          background: #111;
          border-bottom: 1px solid rgba(57,255,20,0.12);
          padding: 13px 14px;
          display: flex;
          align-items: center;
          gap: 10px;
          flex-shrink: 0;
        }
        .gc-avatar {
          width: 36px;
          height: 36px;
          border-radius: 50%;
          background: rgba(57,255,20,0.1);
          border: 1.5px solid rgba(57,255,20,0.35);
          display: flex;
          align-items: center;
          justify-content: center;
          flex-shrink: 0;
        }
        .gc-title {
          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 12px;
          font-weight: 700;
          color: #fff;
          letter-spacing: .06em;
          text-transform: uppercase;
          line-height: 1.2;
        }
        .gc-status {
          display: flex;
          align-items: center;
          gap: 5px;
          margin-top: 3px;
        }
        .gc-dot {
          width: 6px;
          height: 6px;
          border-radius: 50%;
          background: #39ff14;
          animation: gc-blink 2.5s ease infinite;
        }
        @keyframes gc-blink {
          0%,85%,100% { opacity:1; }
          42%          { opacity:.25; }
        }
        .gc-status-txt {
          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 10px;
          color: #39ff14;
          font-weight: 600;
          text-transform: uppercase;
          letter-spacing: .05em;
        }
        .gc-close {
          margin-left: auto;
          width: 28px;
          height: 28px;
          border-radius: 8px;
          background: rgba(255,255,255,0.04);
          border: 1px solid rgba(255,255,255,0.08);
          cursor: pointer;
          display: flex;
          align-items: center;
          justify-content: center;
          color: #555;
          transition: background .15s, color .15s;
          flex-shrink: 0;
        }
        .gc-close:hover { background: rgba(255,255,255,0.1); color: #fff; }

        /* ── Messages ── */
        .gc-messages {
          flex: 1;
          overflow-y: auto;
          padding: 14px 13px;
          display: flex;
          flex-direction: column;
          gap: 9px;
          scroll-behavior: smooth;
          font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif;
        }
        .gc-messages::-webkit-scrollbar { width: 3px; }
        .gc-messages::-webkit-scrollbar-thumb { background: #1a1a1a; border-radius: 2px; }

        .gc-msg {
          display: flex;
          flex-direction: column;
          max-width: 85%;
          animation: gc-msg-in .18s ease forwards;
        }
        @keyframes gc-msg-in {
          from { opacity:0; transform:translateY(5px); }
          to   { opacity:1; transform:translateY(0); }
        }
        .gc-msg.user      { align-self: flex-end; align-items: flex-end; }
        .gc-msg.assistant { align-self: flex-start; align-items: flex-start; }

        .gc-bubble {
          padding: 9px 13px;
          border-radius: 12px;
          font-size: 13px;
          line-height: 1.55;
          word-break: break-word;
        }
        .gc-msg.user .gc-bubble {
          background: #39ff14;
          color: #050505;
          font-weight: 600;
          border-radius: 12px 12px 3px 12px;
        }
        .gc-msg.assistant .gc-bubble {
          background: #161616;
          color: #e0e0e0;
          border: 1px solid rgba(255,255,255,0.06);
          border-radius: 12px 12px 12px 3px;
        }

        /* Typing dots */
        .gc-typing {
          display: flex;
          align-items: center;
          gap: 4px;
          padding: 10px 13px;
          background: #161616;
          border: 1px solid rgba(255,255,255,0.06);
          border-radius: 12px 12px 12px 3px;
          align-self: flex-start;
          animation: gc-msg-in .18s ease forwards;
        }
        .gc-dot-t {
          width: 6px;
          height: 6px;
          border-radius: 50%;
          background: #39ff14;
          animation: gc-bounce 1.2s ease infinite;
        }
        .gc-dot-t:nth-child(2) { animation-delay: .15s; }
        .gc-dot-t:nth-child(3) { animation-delay: .3s; }
        @keyframes gc-bounce {
          0%,60%,100% { transform:translateY(0);   opacity:.4; }
          30%          { transform:translateY(-5px); opacity:1; }
        }

        /* ── Input area ── */
        .gc-input-area {
          padding: 11px 13px;
          border-top: 1px solid rgba(255,255,255,0.05);
          background: #0a0a0a;
          display: flex;
          gap: 8px;
          align-items: center;
          flex-shrink: 0;
        }
        .gc-input {
          flex: 1;
          background: #161616;
          border: 1px solid rgba(255,255,255,0.08);
          border-radius: 10px;
          color: #fff;
          font-size: 16px; /* ≥16px impede zoom automático no iOS */
          font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif;
          padding: 9px 12px;
          outline: none;
          transition: border-color .2s, box-shadow .2s;
          min-width: 0;
          -webkit-text-size-adjust: 100%;
        }
        .gc-input::placeholder { color: #444; }
        .gc-input:focus {
          border-color: rgba(57,255,20,0.4);
          box-shadow: 0 0 0 2px rgba(57,255,20,0.08);
        }

        .gc-send {
          width: 36px;
          height: 36px;
          border-radius: 10px;
          background: #39ff14;
          border: none;
          cursor: pointer;
          display: flex;
          align-items: center;
          justify-content: center;
          color: #050505;
          transition: transform .15s, opacity .15s, box-shadow .15s;
          flex-shrink: 0;
        }
        .gc-send:hover:not(:disabled) {
          transform: scale(1.07);
          box-shadow: 0 0 12px rgba(57,255,20,0.4);
        }
        .gc-send:disabled { opacity: .35; cursor: default; }

        .gc-counter {
          font-size: 10px;
          color: #333;
          text-align: right;
          padding: 0 13px 7px;
          margin-top: -6px;
          font-family: ui-monospace, monospace;
        }
        .gc-counter.warn { color: #ff4d4d; }

        /* ── Mobile ── */
        @media (max-width: 600px) {
          .gc-panel {
            /* Bottom sheet: cola no rodapé, largura total */
            position: fixed;
            bottom: 0;
            right: 0;
            left: 0;
            top: auto;
            width: 100%;
            max-width: 100%;
            /* Altura: 80% da viewport menos safe-area do iOS */
            height: calc(80dvh - env(safe-area-inset-bottom, 0px));
            max-height: calc(80dvh - env(safe-area-inset-bottom, 0px));
            border-radius: 18px 18px 0 0;
            border-left: none;
            border-right: none;
            border-bottom: none;
            /* Padding inferior para barra de navegação do browser */
            padding-bottom: env(safe-area-inset-bottom, 0px);
            animation: gc-open-m .22s ease forwards;
            transform-origin: bottom center;
          }
          @keyframes gc-open-m {
            from { opacity:0; transform:translateY(24px); }
            to   { opacity:1; transform:translateY(0); }
          }
          .gc-btn {
            bottom: calc(16px + env(safe-area-inset-bottom, 0px));
            right: 16px;
            height: 44px;
            padding: 0 14px 0 11px;
          }
          .gc-btn-label { font-size: 10px; }
          /* Input 16px já definido globalmente — não sobrescrever */
          .gc-bubble { font-size: 14px; }
          .gc-messages { padding: 12px 10px; }
          .gc-input-area { padding: 10px 10px; }
        }
